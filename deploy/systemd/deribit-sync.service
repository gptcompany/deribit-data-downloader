[Unit]
Description=Deribit options catalog catch-up (trades and DVOL, BTC and ETH)
Documentation=https://github.com/gptcompany/deribit-data-downloader/blob/master/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sam
Group=sam
# Defaults; override per host in /etc/default/deribit-sync (see README.md).
Environment=DERIBIT_REPO_ROOT=/media/sam/1TB/deribit-data-downloader
Environment=DERIBIT_CATALOG_PATH=/media/sam/2TB-NVMe/data/deribit_options
EnvironmentFile=-/etc/default/deribit-sync
# Resumes from the newest stored trade and the day after the newest DVOL candle,
# so a long outage heals itself; progress goes to the journal (SyslogIdentifier).
ExecStart=/usr/bin/env ${DERIBIT_REPO_ROOT}/.venv/bin/deribit-data catchup --catalog ${DERIBIT_CATALOG_PATH}
# Catalog freshness is refreshed right after each run, also a failed one.
ExecStopPost=-+/usr/bin/systemctl start --no-block deribit-sync-metrics.service
TimeoutStartSec=6h
Restart=no
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deribit-sync
